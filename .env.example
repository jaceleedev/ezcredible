# ─────────────────────────────────────────────────────────────
# 이지크레더블 환경변수
# 로컬은 .env.local, 배포는 Vercel 프로젝트 설정 > Environment Variables
# ─────────────────────────────────────────────────────────────

# Neon Postgres 연결 문자열 (Neon 콘솔 > Connection string > "Pooled connection")
# 예: postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Resend API 키 (resend.com > API Keys). 없으면 신청은 저장되고 알림 메일만 건너뛴다
RESEND_API_KEY=

# 알림을 받을 주소. 쉼표로 여러 명 지정 가능
#
# !! 도메인 인증 전에는 Resend 가입 계정 주소 하나만 넣을 것 !!
# resend.dev 발신 주소로는 가입 계정 주소로만 보낼 수 있고, 허용되지 않은 주소가
# 하나라도 섞이면 요청 전체가 403으로 거부된다 = 아무한테도 안 간다.
CONSULTATION_NOTIFY_TO=

# 보내는 사람. 비워 두면 onboarding@resend.dev로 나간다(위 제한이 걸린다).
# ezcredible.com을 Resend에 인증한 뒤 아래 값으로 바꾼다:
#   CONSULTATION_NOTIFY_FROM="이지크레더블 상담신청 <noreply@ezcredible.com>"
CONSULTATION_NOTIFY_FROM=

# 알림 메일에서 "답장"을 눌렀을 때 갈 주소 (선택)
CONSULTATION_REPLY_TO=

# 관리자 페이지(/admin) 비밀번호. 20자 이상 무작위 문자열을 권장한다
ADMIN_PASSWORD=

# 세션 쿠키 서명 + IP 해시용 시크릿. 각각 다른 값으로, 아래 명령으로 생성한다
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
IP_HASH_SECRET=
